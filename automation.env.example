# Copy to automation.env.local. Never put RFCU credentials here.
DISCOVERY_PROVIDER=codex
# codex uses the developer's own `codex login` session; optional CODEX_MODEL override.
CODEX_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
RFCU_ORIGIN=http://localhost:5173
OPERATOR_PORT=4310
# Optional installed-browser fallback if Playwright's Chromium download is unavailable:
# RFCU_BROWSER_CHANNEL=msedge
# Optional if the target obtains its backend URL elsewhere than target-app/.env.local:
# RFCU_BACKEND_ORIGIN=https://YOUR_PROJECT.supabase.co
# Optional: choose a username present in the local staff file. Default: first MSR.
RFCU_STAFF_USERNAME=
