      "kind": "recoverable",
      "when": {
        "by": "role",
        "role": "alertdialog",
        "name": "Your password expires in 3 days"
      },
      "message": "Informational password-expiry notice; acknowledged automatically.",
      "recover": [
        {
          "by": "role",
          "role": "button",
          "name": "OK, got it",
          "within": {
            "role": "alertdialog",
            "name": "Your password expires in 3 days"
          }
        }
      ],
      "maxRecoveries": 2
    },
    {
      "id": "printer_offline",
      "kind": "recoverable",
      "when": {
        "by": "role",
        "role": "alertdialog",
        "name": "Receipt printer not responding"
