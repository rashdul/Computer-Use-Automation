{
  "schemaVersion": "1.0",
  "id": "rfcu.member.savings-balance",
  "version": 4,
  "name": "Get member savings balance",
  "description": "Log in, find a member by member number, and read the current balance of their Regular Share Savings account.",
  "app": {
    "id": "rfcu-member-services",
    "surface": "web",
    "recordedOrigin": "https://rashed-federal-credit-union.netlify.app",
    "entryPath": "/"
  },
  "inputs": [
    {
      "name": "member_number",
      "type": "string",
      "description": "The member number to look up",
      "pattern": "^\\d{7}$"
    }
  ],
  "secrets": [
    "username",
    "password"
  ],
  "outputs": [
    {
      "name": "savings_balance",
      "type": "money",
      "description": "Current balance of the member's Regular Share Savings account (S01)",
      "currency": "USD"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "intent": "fill label \"Username\"",
      "action": "fill",
      "target": {
        "description": "label \"Username\"",
        "locators": [
          {
            "by": "label",
            "label": "Username"
          },
          {
            "by": "role",
            "role": "textbox",
            "name": "Username"
          }
        ]
      },
      "value": "{{secret.username}}",
      "expect": [],
      "timeoutMs": 15000
    },
    {
      "id": "s2",
      "intent": "fill label \"Password\"",
      "action": "fill",
      "target": {
        "description": "label \"Password\"",
        "locators": [
          {
            "by": "label",
            "label": "Password"
          },
          {
            "by": "role",
            "role": "textbox",
            "name": "Password"
          }
        ]
      },
      "value": "{{secret.password}}",
      "expect": [],
      "timeoutMs": 15000
    },
    {
      "id": "s3",
      "intent": "click button \"Sign in\"",
      "action": "click",
      "target": {
        "description": "button \"Sign in\"",
        "locators": [
          {
            "by": "role",
            "role": "button",
            "name": "Sign in"
          },
          {
            "by": "role",
            "role": "button",
            "name": "Sign in",
            "exact": false
          }
        ]
      },
      "expect": [
        {
          "kind": "url",
          "pattern": "/members"
        }
      ],
      "timeoutMs": 15000
    },
    {
      "id": "s4",
      "intent": "fill searchbox \"Search\"",
      "action": "fill",
      "target": {
        "description": "searchbox \"Search\"",
        "locators": [
          {
            "by": "role",
            "role": "searchbox",
            "name": "Search"
          },
          {
            "by": "label",
            "label": "Search"
          }
        ]
      },
      "value": "{{member_number}}",
      "expect": [],
      "timeoutMs": 15000
    },
    {
      "id": "s5",
      "intent": "click button \"Search\"",
      "action": "click",
      "target": {
        "description": "button \"Search\"",
        "locators": [
          {
            "by": "role",
            "role": "button",
            "name": "Search"
          },
          {
            "by": "role",
            "role": "button",
            "name": "Search",
            "exact": false
          }
        ]
      },
      "expect": [
        {
          "kind": "url",
          "pattern": "/members?q={{member_number}}"
        }
      ],
      "timeoutMs": 15000
    },
    {
      "id": "s6",
      "intent": "click link \"{{member_number}}\"",
      "action": "click",
      "target": {
        "description": "link \"{{member_number}}\"",
        "locators": [
          {
            "by": "role",
            "role": "link",
            "name": "{{member_number}}"
          },
          {
            "by": "role",
            "role": "link",
            "name": "{{member_number}}",
            "exact": false
          },
          {
            "by": "text",
            "text": "{{member_number}}"
          }
        ]
      },
      "expect": [
        {
          "kind": "url",
          "pattern": "/members/{{member_number}}"
        }
      ],
      "timeoutMs": 15000
    },
    {
      "id": "s7",
      "intent": "click link \"Accounts 5\"",
      "action": "click",
      "target": {
        "description": "link \"Accounts 5\"",
        "locators": [
          {
            "by": "role",
            "role": "link",
            "name": "Accounts 5"
          },
          {
            "by": "role",
            "role": "link",
            "name": "Accounts 5",
            "exact": false
          }
        ]
      },
      "expect": [
        {
          "kind": "url",
          "pattern": "/members/{{member_number}}/accounts"
        }
      ],
      "timeoutMs": 15000
    },
    {
      "id": "s8",
      "intent": "extract cell [{{member_number}}-S01 Regular Share Savings] / [Current balance] -> savings_balance",
      "action": "extract",
      "target": {
        "description": "cell [{{member_number}}-S01 Regular Share Savings] / [Current balance]",
        "locators": [
          {
            "by": "cell",
            "row": "{{member_number}}-S01 Regular Share Savings",
            "column": "Current balance"
          }
        ]
      },
      "output": "savings_balance",
      "expect": [],
      "timeoutMs": 15000
    }
  ],
  "success": [
    {
      "kind": "url",
      "pattern": "/members/{{member_number}}/accounts"
    },
    {
      "kind": "visible",
      "target": {
        "description": "heading \"Deposit accounts\"",
        "locators": [
          {
            "by": "role",
            "role": "heading",
            "name": "Deposit accounts"
          }
        ]
      }
    },
    {
      "kind": "visible",
      "target": {
        "description": "columnheader \"Current balance\"",
        "locators": [
          {
            "by": "role",
            "role": "columnheader",
            "name": "Current balance"
          }
        ]
      }
    }
  ],
  "conditions": [
    {
      "id": "member_not_found",
      "kind": "business",
      "when": {
        "by": "text",
        "text": "No members match"
      },
      "message": "No member matches the given member number.",
      "maxRecoveries": 2
    },
    {
      "id": "member_not_found",
      "kind": "business",
      "when": {
        "by": "role",
        "role": "heading",
        "name": "Member not found"
      },
      "message": "No member matches the given member number.",
      "maxRecoveries": 2
    },
    {
      "id": "permission_denied",
      "kind": "business",
      "when": {
        "by": "text",
        "text": "Error 403 · Permission denied"
      },
      "message": "The signed-in staff role may not open this record (restricted record or missing permission).",
      "maxRecoveries": 2
    },
    {
      "id": "sign_in_rejected",
      "kind": "fatal",
      "when": {
        "by": "text",
        "text": "The username or password is incorrect."
      },
      "message": "The console rejected the staff credentials.",
      "maxRecoveries": 2
    },
    {
