{
  "schemaVersion": "1.0",
  "id": "rfcu.member.savings-balance",
  "version": 6,
  "name": "Get member savings balance",
  "description": "Log in, find a member by member number, and retrieve their current Regular Share Savings balance.",
  "app": {
    "id": "rfcu-member-services",
    "surface": "web",
    "recordedOrigin": "https://rashed-federal-credit-union.netlify.app",
    "entryPath": "/"
