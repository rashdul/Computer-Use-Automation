          {
            "by": "role",
            "role": "textbox",
            "name": "Username"
          },
          {
            "by": "label",
            "label": "Username"
          }
        ]
      },
      "value": "{{secret.username}}",
      "expect": [],
      "timeoutMs": 15000
    },
    {
      "id": "s2",
      "intent": "fill textbox \"Password\"",
      "action": "fill",
      "target": {
        "description": "textbox \"Password\"",
        "locators": [
          {
            "by": "role",
            "role": "textbox",
            "name": "Password"
          },
          {
            "by": "label",
            "label": "Password"
          }
        ]
      },
      "value": "{{secret.password}}",
      "expect": [],
