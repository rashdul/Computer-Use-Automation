{
  "schemaVersion": "1.0",
  "id": "wikipedia.article.url",
  "version": 1,
  "name": "Get Wikipedia article URL",
  "description": "Search Wikipedia for a term, open the article, and return its URL.",
  "app": {
    "id": "rfcu-member-services",
    "surface": "web",
    "recordedOrigin": "https://www.wikipedia.org",
    "entryPath": "/"
  },
  "inputs": [
    {
      "name": "search_term",
      "type": "string",
      "description": "Article search phrase"
    }
  ],
  "secrets": [],
  "outputs": [
    {
      "name": "article_url",
      "type": "text",
      "description": "URL of the article"
    }
  ],
  "steps": [
    {
      "id": "s1",
      "intent": "fill searchbox \"Search Wikipedia\"",
      "action": "fill",
      "target": {
        "description": "searchbox \"Search Wikipedia\"",
        "locators": [
          {
            "by": "role",
            "role": "searchbox",
            "name": "Search Wikipedia"
          },
          {
            "by": "label",
            "label": "Search Wikipedia"
          }
        ]
      },
      "value": "{{search_term}}",
      "expect": [],
      "timeoutMs": 15000
    },
    {
      "id": "s2",
      "intent": "press searchbox \"Search Wikipedia\"",
      "action": "press",
      "target": {
        "description": "searchbox \"Search Wikipedia\"",
        "locators": [
          {
            "by": "role",
            "role": "searchbox",
            "name": "Search Wikipedia"
          },
          {
            "by": "label",
            "label": "Search Wikipedia"
          }
        ]
      },
      "value": "Enter",
      "expect": [
        {
          "kind": "url",
          "pattern": "/wiki/Artificial_intelligence"
        }
      ],
      "timeoutMs": 15000
    },
    {
      "id": "s3",
      "intent": "extract link \"Article\" -> article_url",
      "action": "extract",
      "target": {
        "description": "link \"Article\"",
        "locators": [
          {
            "by": "role",
            "role": "link",
            "name": "Article",
            "within": {
              "role": "navigation",
              "name": "Namespaces"
            }
          },
          {
            "by": "role",
            "role": "link",
            "name": "Article",
            "exact": false,
            "within": {
              "role": "navigation",
              "name": "Namespaces"
            }
          }
        ]
      },
      "output": "article_url",
      "extract": "href",
      "expect": [],
      "timeoutMs": 15000
    }
  ],
  "success": [
    {
      "kind": "url",
      "pattern": "/wiki/Artificial_intelligence"
    },
    {
      "kind": "visible",
      "target": {
        "description": "heading \"{{search_term}}\"",
        "locators": [
          {
            "by": "role",
            "role": "heading",
            "name": "{{search_term}}"
