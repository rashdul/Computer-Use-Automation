{
  "schemaVersion": "1.0",
  "id": "youtube.search.first-video-title",
  "version": 1,
  "name": "Search YouTube and return the first video title",
  "description": "Search YouTube for a phrase and extract the title of the first video result.",
  "app": {
    "id": "youtube-public",
    "surface": "web",
    "recordedOrigin": "https://youtube.com",
    "entryPath": "/"
  },
  "inputs": [
    {
      "name": "search_query",
      "type": "string",
      "description": "Phrase to search for on YouTube.",
      "pattern": "^.*$"
    }
  ],
  "secrets": [],
  "outputs": [
    {
      "name": "first_video_title",
      "type": "text",
      "description": "Title of the first video in the YouTube search results."
    }
  ],
  "steps": [
    {
      "id": "s1",
      "intent": "fill combobox \"Search\"",
      "action": "fill",
      "target": {
        "description": "combobox \"Search\"",
        "locators": [
          {
            "by": "role",
            "role": "combobox",
            "name": "Search"
          }
        ]
      },
      "value": "{{search_query}}",
      "expect": [],
      "timeoutMs": 15000
    },
    {
      "id": "s2",
      "intent": "click button \"Search\"",
      "action": "click",
      "target": {
        "description": "button \"Search\"",
        "locators": [
          {
            "by": "role",
            "role": "button",
            "name": "Search"
          }
        ]
      },
      "expect": [
        {
          "kind": "url",
          "pattern": "/results?search_query={{search_query}}"
        }
      ],
      "timeoutMs": 15000
    },
    {
      "id": "s3",
      "intent": "extract heading \"New: The LEAKED AUDIO Trump doesn’t want you to hear 11 minutes, 57 seconds\" -> first_video_title",
      "action": "extract",
      "target": {
        "description": "heading \"New: The LEAKED AUDIO Trump doesn’t want you to hear 11 minutes, 57 seconds\"",
        "locators": [
          {
            "by": "role",
            "role": "heading",
            "name": "New: The LEAKED AUDIO Trump doesn’t want you to hear 11 minutes, 57 seconds"
          },
          {
            "by": "role",
            "role": "heading",
            "name": "New: The LEAKED AUDIO Trump doesn’t want you to hear 11 minutes, 57 seconds",
            "exact": false
          }
        ]
      },
      "output": "first_video_title",
      "expect": [],
      "timeoutMs": 15000
    }
  ],
  "success": [
    {
      "kind": "url",
      "pattern": "/results?search_query={{search_query}}"
    },
    {
      "kind": "visible",
      "target": {
        "description": "button \"Search filters\"",
        "locators": [
          {
            "by": "role",
            "role": "button",
            "name": "Search filters"
          }
        ]
      }
    }
  ],
  "conditions": [
    {
      "id": "no_results",
      "kind": "business",
      "when": {
        "by": "text",
        "text": "No results found"
      },
      "message": "The search returned no videos.",
      "maxRecoveries": 2
    }
  ],
  "usage": {
    "replay": "npm run replay -- --artifact artifacts/youtube.search.first-video-title.v1.json --input \"search_query=<search_query>\""
  },
  "provenance": {
    "discoveredAt": "2026-10-01T15:54:58.356Z",
    "runId": "discovery-2026-10-01T15-54-35",
    "goal": "open youtube, search for {{search_query}}, return the first video titles",
    "model": "openai:gpt-6-luna",
    "llmCalls": 4
  }
}
