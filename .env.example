# Copy to .env (git-ignored) and fill in. Variables already set in your shell take precedence.

# Sign-in for whichever site you are automating. Every secret an app profile lists
# is read from CUA_<NAME>: {{secret.username}} -> CUA_USERNAME, {{secret.password}} -> CUA_PASSWORD.
# (For the RFCU demo app, any staff row of target-app/STAFF_CREDENTIALS.local.md works.)
CUA_USERNAME=
CUA_PASSWORD=

# Optional: administrator for `npm run demo:env` (RFCU demo only). If unset, the
# dwhitfield row of target-app/STAFF_CREDENTIALS.local.md is used.
# CUA_ADMIN_USERNAME=
# CUA_ADMIN_PASSWORD=

# Optional: LLM for discovery (claude | codex | openai) and its model.
# CUA_LLM=claude
# CUA_MODEL=
# OPENAI_API_KEY=
